{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "ignore": [
    ".next/**"
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useSingleVarDeclarator": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noDebugger": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "linter": {
      "tailwindDirectives": true
    },
    "formatter": {
      "tailwindDirectives": true
    }
  }
}
